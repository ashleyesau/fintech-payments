# Mirrors SimSettings in simulator/config.py. Copy to .env before running.

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fintech
POSTGRES_USER=sim
POSTGRES_PASSWORD=sim

# Runtime
LOG_LEVEL=INFO

# Simulation defaults (CLI flags override these)
DEFAULT_MERCHANT_COUNT=1000
SIMULATION_START_DATE=2025-01-01
SIMULATION_END_DATE=2026-01-01
STREAMING_SPEED_FACTOR=3600
RANDOM_SEED=42
CHECKPOINT_PATH=checkpoint.json

# Feature flags
ENABLE_RISK_EVENTS=true
ENABLE_LOAN_APPLICATIONS=true
ENABLE_PAYSHAP=true
