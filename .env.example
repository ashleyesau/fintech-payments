# Mirrors SimSettings in simulator/config.py and CdcSettings in cdc/config.py. Copy to .env before running.

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fintech
POSTGRES_USER=sim
POSTGRES_PASSWORD=sim

# Runtime
LOG_LEVEL=INFO

# Simulation defaults (CLI flags override these)
DEFAULT_MERCHANT_COUNT=1000
SIMULATION_START_DATE=2025-01-01
SIMULATION_END_DATE=2026-01-01
STREAMING_SPEED_FACTOR=3600
RANDOM_SEED=42
CHECKPOINT_PATH=checkpoint.json

# Feature flags
ENABLE_RISK_EVENTS=true
ENABLE_LOAN_APPLICATIONS=true
ENABLE_PAYSHAP=true

# CDC consumer (CdcSettings). The consumer reads the fintech_cdc database; point the
# generator at it with POSTGRES_DB=fintech_cdc and a separate CHECKPOINT_PATH.
CDC_HOST=localhost
CDC_PORT=5432
CDC_DB=fintech_cdc
CDC_USER=sim
CDC_PASSWORD=sim
CDC_SLOT_NAME=cdc_r01
CDC_PUBLICATION=fintech_cdc
CDC_GCS_BUCKET=cdc_landing
CDC_BATCH_SIZE=10000
CDC_POLL_INTERVAL_SECONDS=5
