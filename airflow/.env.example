# Copy this file to airflow/.env and fill in the three paths before running docker compose.
# airflow/.env is gitignored.

# Absolute path on the host to the bronze-writer impersonated credentials file.
# Created in GCS phase session 15 at: /Users/yourname/.config/gcloud_bronze
BRONZE_WRITER_CREDS_PATH=/Users/yourname/.config/gcloud_bronze

# Absolute path on the host to your Application Default Credentials JSON file.
# If it does not exist, run: gcloud auth application-default login
# That command writes to: ~/.config/gcloud/application_default_credentials.json
ADC_CREDS_PATH=/Users/yourname/.config/gcloud/application_default_credentials.json

# Absolute path on the host to the directory that contains profiles.yml.
# After running: cp dbt/profiles.yml.example ~/.dbt/profiles.yml
# the directory is: ~/.dbt
DBT_PROFILES_DIR=/Users/yourname/.dbt

# Airflow webserver secret key. Change this to a random string.
AIRFLOW_SECRET_KEY=changeme

# CDC slot name: determines which landing prefix bronze_write reads from.
# Set this to the slot used in the most recent CDC consumer run.
# Example: cdc_r01 reads from gs://cdc_landing/cdc/cdc_r01/
CDC_SLOT_NAME=cdc_r01
